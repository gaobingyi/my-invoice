# 通用（docker compose 都吃，dev 本地起 backend 也可直接 source .env 覆盖 yml）
# 上传目录（docker 部署 /app/uploads，本地 dev 不 source 时走 yml 默认 ./uploads）
UPLOAD_DIR=./uploads
# 模型
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=big-pickle
# LLM 兜底开关（默认 true。设 false 可彻底禁用 LLM 调用，正则解析不全的字段直接留 null）
LLM_ENABLED=true
# 登录认证
JWT_SECRET=change-me-in-production-please-32bytes-or-more
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# TRUST_PROXY：故意不放进 .env（compose 硬编码 true，本地 dev yml 默认 false）