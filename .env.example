# UPLOAD_DIR：故意不放进 .env——它在 docker 里是卷挂载点（/app/uploads），
# 改了 .env 但卷没挂到新路径会导致文件落 tmpfs、重启丢失，DB 留孤儿行。
# 改上传路径请改 docker-compose.yml（连 volume mount 一起改）。dev 本地
# 不 source .env 时走 yml 默认 ./uploads；想临时改 dev 路径用 shell export 即可。
#
# 模型
LLM_ENABLED=true
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=public
LLM_MODEL=big-pickle
# 登录
JWT_SECRET=change-me-in-production-please-32bytes-or-more
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123