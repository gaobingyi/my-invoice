# 复制为 .env 使用（.env 已 gitignore，勿提交）
# SQLite 是文件式数据库，无 DB 凭据（DB_PASSWORD/MYSQL_ROOT_PASSWORD 已移除）。
LLM_API_KEY=your_llm_api_key
APP_LLM_MODEL=big-pickle
APP_LLM_BASE_URL=https://opencode.ai/zen/v1
# APP_TRUST_PROXY：本地 dev 用 application.yml 默认 false（无反代）；docker 部署在
# compose 里硬编码 true。这俩场景已覆盖所有用法，不在 .env 暴露。
# 登录认证：JWT 签名密钥（生产必须改强随机值）+ 初始管理员账号
JWT_SECRET=change-me-in-production-please-32bytes-or-more
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123