# UPLOAD_DIR：故意不放进 .env——它在 docker 里是卷挂载点（/app/uploads），
# 改了 .env 但卷没挂到新路径会导致文件落 tmpfs、重启丢失，DB 留孤儿行。
# 改上传路径请改 docker-compose.yml（连 volume mount 一起改）。dev 本地
# 不 source .env 时走 yml 默认 ./uploads；想临时改 dev 路径用 shell export 即可。
#
# 模型
LLM_ENABLED=true
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=public
LLM_MODEL=big-pickle
# 登录
JWT_SECRET=change-me-in-production-please-32bytes-or-more
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 微信小程序登录（体验版）。appid/secret 来自 mp.weixin.qq.com；
# 首次绑定：allowed-openids 留空登录一次，后端日志打出尝试者 openid，填入后重启。
WX_APPID=
WX_SECRET=
WX_ALLOWED_OPENIDS=
# 备份心跳（dead-man switch，仅 VPS 用）：backup-mega.sh 成功 ping 此 URL、失败 ping
# <URL>/fail，超时不 ping 由 healthchecks.io 侧告警。形如 https://hc-ping.com/<uuid>，
# 留空 = 不告警（本地跑无需配置，脚本静默跳过）。
HEALTHCHECK_URL=