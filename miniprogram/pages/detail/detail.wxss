.field {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
  font-size: 27rpx;
}

.field:last-child {
  border-bottom: none;
}

.label {
  width: 240rpx;
  color: #8f959e;
  flex-shrink: 0;
}

.value {
  flex: 1;
  word-break: break-all;
}

.actions {
  margin: 40rpx 24rpx;
}

button {
  width: 100%;
  font-size: 30rpx;
}

button::after {
  border: none;
}

.preview-btn {
  margin-bottom: 24rpx;
}

.delete-btn {
  background: #fff;
  color: #d83931;
  border: 1rpx solid #d83931;
  border-radius: 12rpx;
}
