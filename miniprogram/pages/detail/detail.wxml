<view wx:if="{{invoice}}">
  <view class="card">
    <view class="field" wx:for="{{fields}}" wx:key="label">
      <text class="label">{{item.label}}</text>
      <text class="value">{{item.value}}</text>
    </view>
  </view>

  <view class="actions">
    <button class="btn-primary preview-btn" bindtap="previewPdf" disabled="{{previewing}}">查看原票</button>
    <button class="delete-btn" bindtap="confirmDelete" disabled="{{deleting}}">删除</button>
  </view>
</view>
