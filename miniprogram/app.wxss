page {
  background: #f5f6f8;
  font-size: 28rpx;
  color: #1f2329;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #1f6feb;
  color: #fff;
  border-radius: 12rpx;
}

.btn-primary[disabled] {
  background: #a8c7f5;
  color: #fff;
}
